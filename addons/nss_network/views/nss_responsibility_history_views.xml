<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_nss_responsibility_history_list" model="ir.ui.view">
        <field name="name">nss.responsibility.history.list</field>
        <field name="model">nss.responsibility.history</field>
        <field name="arch" type="xml">
            <list string="Historique des responsabilités" decoration-muted="not is_current">
                <field name="partner_id"/>
                <field name="organization_id"/>
                <field name="country_membership_id"/>
                <field name="role"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="is_current" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_nss_responsibility_history_form" model="ir.ui.view">
        <field name="name">nss.responsibility.history.form</field>
        <field name="model">nss.responsibility.history</field>
        <field name="arch" type="xml">
            <form string="Historique de responsabilité">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="organization_id"/>
                            <field name="country_membership_id"/>
                            <field name="role"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="is_current" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_nss_responsibility_history_search" model="ir.ui.view">
        <field name="name">nss.responsibility.history.search</field>
        <field name="model">nss.responsibility.history</field>
        <field name="arch" type="xml">
            <search string="Historique des responsabilités">
                <field name="partner_id"/>
                <field name="organization_id"/>
                <field name="country_membership_id"/>
                <field name="role"/>
                <filter string="En poste actuellement" name="filter_current" domain="[('is_current', '=', True)]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Pays NSS" name="group_country" context="{'group_by': 'country_membership_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nss_responsibility_history" model="ir.actions.act_window">
        <field name="name">Responsabilités</field>
        <field name="res_model">nss.responsibility.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nss_responsibility_history_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer un historique de responsabilité
            </p>
            <p>
                Aucune coordinatrice ou responsable réelle n'est créée par ce module.
            </p>
        </field>
    </record>

</odoo>

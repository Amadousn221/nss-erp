<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_nss_membership_list" model="ir.ui.view">
        <field name="name">nss.membership.list</field>
        <field name="model">nss.membership</field>
        <field name="arch" type="xml">
            <list string="Adhésions">
                <field name="organization_id"/>
                <field name="status"/>
                <field name="application_date"/>
                <field name="admission_date"/>
                <field name="fee_due"/>
                <field name="fee_paid"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_nss_membership_form" model="ir.ui.view">
        <field name="name">nss.membership.form</field>
        <field name="model">nss.membership</field>
        <field name="arch" type="xml">
            <form string="Adhésion">
                <sheet>
                    <group>
                        <group>
                            <field name="organization_id" options="{'no_create': True}"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="application_date"/>
                            <field name="admission_date"/>
                            <field name="last_renewal_date"/>
                        </group>
                    </group>
                    <group string="Cotisation">
                        <field name="currency_id"/>
                        <field name="fee_due"/>
                        <field name="fee_paid"/>
                    </group>
                    <group string="Membres déclarés">
                        <field name="member_count_declared"/>
                        <field name="member_count_date"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_nss_membership_search" model="ir.ui.view">
        <field name="name">nss.membership.search</field>
        <field name="model">nss.membership</field>
        <field name="arch" type="xml">
            <search string="Adhésions">
                <field name="organization_id"/>
                <filter string="En cours" name="filter_en_cours" domain="[('status', '=', 'en_cours')]"/>
                <filter string="Actives" name="filter_active" domain="[('status', '=', 'active')]"/>
                <filter string="Expirées" name="filter_expiree" domain="[('status', '=', 'expiree')]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Statut" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nss_membership" model="ir.actions.act_window">
        <field name="name">Adhésions</field>
        <field name="res_model">nss.membership</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nss_membership_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer une adhésion
            </p>
            <p>
                Aucune adhésion réelle n'est créée par ce module.
            </p>
        </field>
    </record>

</odoo>
